# Part 1 (Regression model) ----
library(ISLR2)
data(Hitters)
# Q1: Consider the variables League and Division. Check whether these variables
#     are factors; if they are not, convert them to the appropriate format.
#     Then estimate a multiple linear regression model where the response
#     variable is Salary and League and Division are the covariates.
#     Which covariates are statistically significant? Report the name(s) of the
#     variable(s), the value of the coefficient(s), the p-value(s) and provide
#     a comment of the coefficient.
Hitters$League   <- as.factor(Hitters$League)
Hitters$Division <- as.factor(Hitters$Division)
lm1 <- lm(Salary ~ League + Division, data = Hitters)
summary(lm1)
# Q2: Variable Salary contains some outliers, detect them and create a new dataset
#     Hitter_2 without them. How many records have been removed? Then compute
#     the correlation between Hits and Runs and AtBat and Hits.
outliers <- boxplot(Hitters$Salary, plot=FALSE)$out
Hitters_2 <- Hitters[-which(Hitters$Salary >= min(outliers)),]
cor(Hitters_2$Hits, Hitters_2$Runs, na.rm = TRUE)
cor(Hitters_2$Hits, Hitters_2$Runs)
cor(Hitters_2$AtBat, Hitters_2$Hits)
lm2 <- lm(Salary ~ Hits + Runs + RBI + Walks + Years, data = Hitters_2)
summary(lm2)
Hitters_2
predict(lm2, newdata = as.data.frame(c(Hits = 110, Runs = 50,
RBI = 45, Walks = 20,
Years = 5)))
as.data.frame(c(Hits = 110, Runs = 50,
RBI = 45, Walks = 20,
Years = 5)
as.data.frame(c(Hits = 110, Runs = 50,
as.data.frame(c(Hits = 110, Runs = 50,
RBI = 45, Walks = 20,
Years = 5))
predict(lm2, newdata = as.data.frame(Hits = 110, Runs = 50,
RBI = 45, Walks = 20,
Years = 5))
as.data.frame(Hits = 110, Runs = 50,
RBI = 45, Walks = 20,
Years = 5)
predict(lm2, newdata = data.frame(Hits = 110, Runs = 50,
RBI = 45, Walks = 20,
Years = 5))
summary(Hitter_2$Salary)
summary(Hitters_2$Salary)
predict(lm2, newdata = data.frame(Hits = 110, Runs = 50,
RBI = 45, Walks = 20,
Years = 5))
summary(lm2)
lm3 <- lm(Salary ~ Hits + Walks + Years, data = Hitters_2)
summary(lm3)
anova(lm2, lm3, test="Chisq")
# Stratified KM curves
fit.sex <- survfit(Surv(time, status) ~ sex, data = BrainCancer)
# Part 2 (Survival analysis) ----
library(ISLR2)
library(survival)
# Stratified KM curves
fit.sex <- survfit(Surv(time, status) ~ sex, data = BrainCancer)
fit.sex
survdiff(Surv(time, status) ~ sex, data = lung)
# Log-rank test
survdiff(Surv(time, status) ~ sex, data = BrainCancer)
# Hazard ratio
hazard_ratio <- (18.5/15)/(16.5/20)
hazard_ratio
BrainCancer
?BrainCancer
mod.cox <- coxph(Surv(time, status) ~ diagnosis + sex + gtv, data = BrainCancer)
summary(mod.cox)
mod.cox <- coxph(Surv(time, status) ~ diagnosis + sex + gtv, data = BrainCancer)
summary(mod.cox)
ggcoxdiagnostics(mod.cox, type = "deviance")
library(survival)
library(survminer)
ggcoxdiagnostics(mod.cox, type = "martingale")
# Test for PH using scaled Schoenfeld test for PH
# H0: Hazards are proportional
# H1: Hazards are NOT proportional
# cox.zph() return tests for each X and for the global model
test.ph <- cox.zph(mod.cox)
test.ph # REMARK: pvalue > 0.5 -> ph assumptions is ok
# Fit the Cox's regression model:
mod.cox <- coxph(Surv(time, status) ~ age + sex + ph.karno + wt.loss, data =  lung)
# Test for PH using scaled Schoenfeld test for PH
# H0: Hazards are proportional
# H1: Hazards are NOT proportional
# cox.zph() return tests for each X and for the global model
test.ph <- cox.zph(mod.cox)
test.ph # REMARK: pvalue > 0.5 -> ph assumptions is ok
mod.cox <- coxph(Surv(time, status) ~ diagnosis + sex + gtv, data = BrainCancer)
summary(mod.cox)
test.ph <- cox.zph(mod.cox)
test.ph
