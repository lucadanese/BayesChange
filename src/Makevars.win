CXX_STD = CXX17

# Rtools (>= 4.0) ships GSL; LIB_GSL lets users point to a custom installation.
PKG_CPPFLAGS = $(if $(LIB_GSL),-I"$(LIB_GSL)/include")
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(if $(LIB_GSL),-L"$(LIB_GSL)/lib") -lgsl -lgslcblas
